# Copy to .env.production (or set in the pipeline) before `npm run build`.
# Empty values = local mode: no login, calls /api on the Vite dev proxy.
VITE_API_BASE_URL=https://apim-xxxx.azure-api.net/orders
VITE_AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_API_SCOPE=api://orders-backend-xxxx/Orders.Read